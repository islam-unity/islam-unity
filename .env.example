# ============================================
# Islam Unity (اتحاد اسلامی) - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.
# Never commit the .env file with real credentials!

# --- Project Settings / تنظیمات پروژه ---
PROJECT_NAME="Islam Unity"
API_V1_STR="/v1"

# --- Authentication / احراز هویت ---
# Generate a strong secret key for JWT token signing
SECRET_KEY="your-secret-key-here-change-in-production"
ALGORITHM="HS256"
# Token expiration in minutes (43200 = 30 days)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Database / پایگاه داده ---
DATABASE_URL="sqlite+aiosqlite:///./ettehad.db"

# --- DeepSeek AI / هوش مصنوعی دیپ‌سیک ---
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY_UNITY="your-deepseek-api-key"
DEEPSEEK_BASE_URL_UNITY="https://api.deepseek.com"
MODEL_DEEPPSEEK_LLM_UNITY="deepseek-chat"

# --- Avalai AI / هوش مصنوعی آوالای ---
# Get your API key from: https://avalai.ir/
AVALAI_BASE_URL_UNITY="https://api.avalai.ir/v1"
AVALAI_API_KEY="your-avalai-api-key"
AVALAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- NVIDIA AI / هوش مصنوعی انویدیا ---
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY="your-nvidia-api-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
