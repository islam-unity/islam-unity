PROJECT_NAME="اپلیکیشن جامع معارفی اتحاد"
API_V1_STR="/v1"
SECRET_KEY="ettehad-secret-key-change-this-in-production-securely"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database: Default SQLite async (or postgresql+asyncpg://user:pass@localhost:5432/ettehad)
DATABASE_URL="sqlite+aiosqlite:///./ettehad.db"

# =====================================================================
# ارائه‌دهندگان هوش مصنوعی (AI Providers Configuration)
# =====================================================================

# DeepSeek - مدل اصلی گفتگوی هوشمند، تحلیل و چت
DEEPSEEK_API_KEY_UNITY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL_UNITY="https://api.deepseek.com"
MODEL_DEEPPSEEK_LLM_UNITY="deepseek-chat"

# Avalai - سرویس تولید تعبیه برداری (Vector Embeddings)
AVALAI_BASE_URL_UNITY="https://api.avalai.ir/v1"
AVALAI_API_KEY="aa-your-avalai-api-key"
AVALAI_EMBEDDING_MODEL="text-embedding-3-small"

# TypeSafe AI - موتور تصمیم‌گیری سریع سامانه یک JEV
TYPESAFE_API_KEY="apikey_your-typesafe-api-key"

# NVIDIA NIM - پردازش‌های پس‌زمینه، کارهای غیرضروری و بدون محدودیت زمانی، خلاصه‌سازی و نماینده چانک‌ها
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL_BOLT="nvidia/nemotron-3.5-bolt-e4b"
NVIDIA_MODEL_SUPER_VL="nvidia/nemotron-3.5-super-vl-120b-a12b"
NVIDIA_MODEL_MISTRAL_LARGE="mistralai/mistral-large-4-1t-a52b"
NVIDIA_DEFAULT_MODEL="nvidia/nemotron-3.5-bolt-e4b"
NVIDIA_RPM_LIMIT=40
NVIDIA_FALLBACK_MODELS='["nvidia/nemotron-3.5-bolt-e4b", "nvidia/nemotron-3.5-super-vl-120b-a12b", "mistralai/mistral-large-4-1t-a52b"]'

# =====================================================================
# تفکیک مدل‌ها و Base URL برای تک‌تک بخش‌های سامانه (Per-Section Models)
# =====================================================================

# ۱. گفتگوی هوشمند و استریم (AI Chat & Stream) - DeepSeek
AI_CHAT_MODEL="deepseek-chat"
AI_CHAT_BASE_URL="https://api.deepseek.com"
AI_CHAT_API_KEY=""
AI_CHAT_PROVIDER="openai_compatible" # openai_compatible / gemini

# ۲. تعبیه برداری و پایگاه داده معنایی (Vector Embeddings) - Avalai
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_BASE_URL="https://api.avalai.ir/v1"
AI_EMBEDDING_API_KEY=""
AI_EMBEDDING_PROVIDER="openai_compatible"

# ۳. موتور عامل هوشمند و مسیریابی چندمرحله‌ای (Agentic RAG Engine) - DeepSeek
AI_AGENTIC_RAG_MODEL="deepseek-chat"
AI_AGENTIC_RAG_BASE_URL="https://api.deepseek.com"
AI_AGENTIC_RAG_API_KEY=""
AI_AGENTIC_RAG_PROVIDER="openai_compatible"

# ۴. مدل تصمیم‌گیر سامانه یک JEV (TypeSafe System One Engine)
JEV_MODEL="jev-latest"
JEV_BASE_URL="https://api.typesafe.ai/v1/systemone"
JEV_API_URL="https://api.typesafe.ai/v1/systemone"
JEV_API_KEY=""
JEV_PROVIDER="jev_systemone"

# ۵. هوش مصنوعی کتابخانه و چت با کتب (Library AI) - DeepSeek
AI_LIBRARY_MODEL="deepseek-chat"
AI_LIBRARY_BASE_URL="https://api.deepseek.com"
AI_LIBRARY_API_KEY=""
AI_LIBRARY_PROVIDER="openai_compatible"

# ۶. تدبر و تحلیل هوشمند آیات قرآن (Quran Tadabbur AI) - DeepSeek
AI_QURAN_MODEL="deepseek-chat"
AI_QURAN_BASE_URL="https://api.deepseek.com"
AI_QURAN_API_KEY=""
AI_QURAN_PROVIDER="openai_compatible"

# ۷. دستیار هوشمند مشاوران و پاسخ به استفتائات (Scholar Consultation AI) - DeepSeek
AI_CONSULTATION_MODEL="deepseek-chat"
AI_CONSULTATION_BASE_URL="https://api.deepseek.com"
AI_CONSULTATION_API_KEY=""
AI_CONSULTATION_PROVIDER="openai_compatible"

# ۸. پردازش چانک‌ها، خلاصه‌سازی و تولید نماینده‌های چانک (Chunk Representation AI) - NVIDIA
AI_CHUNK_REPRESENTATION_MODEL="nvidia/nemotron-3.5-bolt-e4b"
AI_CHUNK_REPRESENTATION_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_CHUNK_REPRESENTATION_API_KEY=""
AI_CHUNK_REPRESENTATION_PROVIDER="openai_compatible"

# Qdrant Vector DB (In Docker, set host to "qdrant" and fallback to false)
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION="islamic_knowledge"
QDRANT_USE_MEMORY_FALLBACK=false

# Token Pricing & Currency (USD & IRR)
USD_TO_IRR_RATE=950000.0
DEFAULT_INPUT_COST_PER_M=0.075
DEFAULT_OUTPUT_COST_PER_M=0.30
DEFAULT_CACHED_COST_PER_M=0.01875

# File Uploads
UPLOAD_DIR="./media/uploads"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25MB

# CORS
CORS_ORIGINS=["*"]
